# 枫桥智盾 · 环境配置模板
# 复制为 .env 并填入实际值

# AI 后端：ollama | deepseek | mock
AI_BACKEND=ollama

# Ollama 本地模型
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# DeepSeek 云端 API（AI_BACKEND=deepseek 时必填）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 数据库读写分离集群 =====
# 单节点模式（默认）：仅配 DB_HOST，读写同库
# 集群模式：配 DB_MASTER_HOST + DB_SLAVE_HOSTS
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=FengQiao@2026
DB_NAME=fengqiao_zhidun

# 主库（写），不配则用 DB_HOST
# DB_MASTER_HOST=localhost

# 从库（读），逗号分隔，不配则读写同库
# DB_SLAVE_HOSTS=localhost:3307,localhost:3308

# 读库选择策略：round_robin | random
DB_READ_STRATEGY=round_robin

# ===== Redis =====
# REDIS_HOST=localhost
# REDIS_PORT=6379
